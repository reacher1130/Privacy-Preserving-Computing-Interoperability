+export default function routerBeforeEach(router: any) {
+  router.beforeEach((to: any, from: any, next: any) => {
+    const demoAuthDisabled = (window as any).__FATE_DEMO_AUTH_DISABLED__ === true;
+    if (demoAuthDisabled && !(store.state as any).auth.username) {
+      store.commit('SET_USERNAME', 'demo');
+    }
+    if (!to.name.match(/signin/i)) {
+      store.dispatch('setRouteRecord', to)
+    }
+    if (!demoAuthDisabled && !(store.state as any).auth.username && !to.name.match(/signin/i)) {
+      next({ path: '/signIn' });
     } else {
       next();
     }
