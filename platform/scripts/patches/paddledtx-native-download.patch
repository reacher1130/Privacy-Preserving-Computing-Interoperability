@@ -0,0 +1,40 @@
+/** Save a successful download; API errors must never become downloaded files. */
+export async function saveDownload(
+  blob: Blob,
+  filename: string,
+  contentDisposition?: unknown
+): Promise<void> {
+  const attachment =
+    typeof contentDisposition === 'string' &&
+    /\battachment\b/i.test(contentDisposition);
+  if (!attachment && /(?:\/|\+)json(?:;|$)/i.test(blob.type)) {
+    let payload: any;
+    try {
+      payload = JSON.parse(await blob.text());
+    } catch {
+      // A file's declared MIME type does not make its contents an API response.
+    }
+    if (
+      payload &&
+      !Array.isArray(payload) &&
+      Object.prototype.hasOwnProperty.call(payload, 'data') &&
+      (typeof payload.code === 'string' || typeof payload.code === 'number') &&
+      String(payload.code) !== '0' &&
+      (typeof payload.msg === 'string' || typeof payload.message === 'string')
+    ) {
+      throw new Error(payload.msg || payload.message || '下载失败');
+    }
+  }
+  const link = document.createElement('a');
+  const url = URL.createObjectURL(blob);
+  try {
+    link.href = url;
+    link.download = filename;
+    link.style.display = 'none';
+    document.body.appendChild(link);
+    link.click();
+  } finally {
+    link.remove();
+    URL.revokeObjectURL(url);
+  }
+}
