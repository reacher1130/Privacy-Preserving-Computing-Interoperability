+// Exercise the production helper with Node's Blob and a minimal browser DOM.
+const assert = require('node:assert/strict');
+const fs = require('node:fs');
+const path = require('node:path');
+const vm = require('node:vm');
+const test = require('node:test');
+const ts = require('typescript');
+
+function browser(clickError = false) {
+  const counts = {created: 0, clicked: 0, removed: 0, revoked: 0};
+  const link = {
+    style: {},
+    click() {
+      counts.clicked++;
+      if (clickError) throw new Error('browser click failed');
+    },
+    remove() {
+      counts.removed++;
+    },
+  };
+  const module = {exports: {}};
+  const context = {
+    module,
+    exports: module.exports,
+    Blob,
+    document: {createElement: () => link, body: {appendChild: () => {}}},
+    URL: {
+      createObjectURL() {
+        counts.created++;
+        return 'blob:public-test';
+      },
+      revokeObjectURL(value) {
+        assert.equal(value, 'blob:public-test');
+        counts.revoked++;
+      },
+    },
+  };
+  const source = fs.readFileSync(
+    path.join(__dirname, '../src/libs/download.ts'),
+    'utf8'
+  );
+  const compiled = ts.transpileModule(source, {
+    compilerOptions: {
+      module: ts.ModuleKind.CommonJS,
+      target: ts.ScriptTarget.ES2020,
+    },
+  }).outputText;
+  vm.runInNewContext(compiled, context);
+  return {save: module.exports.saveDownload, counts, link};
+}
+
+test('preserves filenames and cleans object URLs after a CSV download', async () => {
+  const b = browser();
+  await b.save(new Blob(['id,x\n1,2\n'], {type: 'text/csv'}), 'public.csv');
+  assert.equal(b.link.download, 'public.csv');
+  assert.equal(b.link.href, 'blob:public-test');
+  assert.deepEqual(b.counts, {created: 1, clicked: 1, removed: 1, revoked: 1});
+});
+
+test('HTTP 200 JSON business errors do not create or save files', async () => {
+  for (const error of [
+    {code: 'SignErr', msg: '签名错误', data: null},
+    {code: 4, message: 'no result', data: null},
+  ]) {
+    const b = browser();
+    await assert.rejects(
+      b.save(
+        new Blob([JSON.stringify(error)], {type: 'application/json'}),
+        'result.csv'
+      )
+    );
+    assert.deepEqual(b.counts, {
+      created: 0,
+      clicked: 0,
+      removed: 0,
+      revoked: 0,
+    });
+  }
+});
+
+test('real JSON files remain valid, including attachment bodies resembling API envelopes', async () => {
+  for (const [body, disposition] of [
+    ['{"columns":["id","x"]}', undefined],
+    ['{"code":"field-name","description":"metadata"}', undefined],
+    [
+      '{"code":"SignErr","msg":"literal dataset value","data":null}',
+      'attachment; filename=metadata.json',
+    ],
+  ]) {
+    const b = browser();
+    await b.save(
+      new Blob([body], {type: 'application/json'}),
+      'metadata.json',
+      disposition
+    );
+    assert.equal(b.counts.clicked, 1);
+    assert.equal(b.counts.revoked, 1);
+  }
+});
+
+test('failed browser saves still remove the link and revoke the object URL', async () => {
+  const b = browser(true);
+  await assert.rejects(
+    b.save(new Blob(['public']), 'public.meta'),
+    /browser click failed/
+  );
+  assert.equal(b.counts.removed, 1);
+  assert.equal(b.counts.revoked, 1);
+});
