--- /dev/null
+++ b/pkg/auth/authorization_boundary_test.go
@@ -0,0 +1,48 @@
+package auth
+
+import (
+	"crypto/ecdsa"
+	"crypto/elliptic"
+	"crypto/rand"
+	"crypto/sha256"
+	"encoding/hex"
+	"fmt"
+	"testing"
+	"time"
+)
+
+func TestAuthorizationRecoveryBoundary(t *testing.T) {
+	key, err := ecdsa.GenerateKey(elliptic.P256(), rand.Reader)
+	if err != nil {
+		t.Fatal(err)
+	}
+	message := "pageNo=1pageSize=20"
+	for _, tc := range []struct {
+		name string
+		offset int64
+		message string
+		want bool
+	}{
+		{"fresh", 0, message, true},
+		{"tampered", 0, message + "x", false},
+		{"expired", -301, message, false},
+		{"future", 60, message, false},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			stamp := time.Now().Unix() + tc.offset
+			digest := sha256.Sum256([]byte(fmt.Sprintf("%s%d", message, stamp)))
+			r, s, err := ecdsa.Sign(rand.Reader, key, digest[:])
+			if err != nil {
+				t.Fatal(err)
+			}
+			signature := make([]byte, 64)
+			r.FillBytes(signature[:32])
+			s.FillBytes(signature[32:])
+			token := fmt.Sprintf("auth-v1/%d/%s", stamp, hex.EncodeToString(signature))
+			err = VerifyAuthorization(&key.PublicKey, tc.message, token, 300)
+			if (err == nil) != tc.want {
+				t.Fatalf("signature acceptance = %v, want %v", err == nil, tc.want)
+			}
+		})
+	}
+}
