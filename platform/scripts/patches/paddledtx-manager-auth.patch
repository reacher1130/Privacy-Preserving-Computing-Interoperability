+++ b/controllers/recovery_authority_test.go
@@ -0,0 +1,38 @@
+package controllers
+
+import (
+	"net/http/httptest"
+	"testing"
+
+	"github.com/beego/beego/v2/server/web/context"
+)
+
+func TestRecoveryAuthorityPolicy(t *testing.T) {
+	for _, tc := range []struct {
+		path string
+		public bool
+	}{
+		{"user/login", true},
+		{"user/register", true},
+		{"data/list", false},
+		{"data/list/", false},
+		{"data/download", false},
+		{"task/result/download", false},
+		{"algo/download", false},
+		{"user/clearpwd", false},
+		{"permission/role/delete", false},
+		{"unknown/download", false},
+		{"unknown", false},
+	} {
+		t.Run(tc.path, func(t *testing.T) {
+			ctx := context.NewContext()
+			ctx.Request = httptest.NewRequest("GET", PathPrefix + tc.path, nil)
+			controller := BaseController{}
+			controller.Ctx = ctx
+			err := controller.CheckAuthority()
+			if (err == nil) != tc.public {
+				t.Fatalf("anonymous acceptance = %v, want %v", err == nil, tc.public)
+			}
+		})
+	}
+}
