+package filesafe
+
+import (
+	"errors"
+	"os"
+	"path/filepath"
+	"strings"
+)
+
+func Component(value string) bool {
+	return value != "" && value != "." && value != ".." &&
+		!filepath.IsAbs(value) && filepath.Base(value) == value &&
+		!strings.ContainsAny(value, "/\\\x00")
+}
+
+func UploadDir(owner string) (string, error) {
+	if !Component(owner) {
+		return "", errors.New("invalid upload owner")
+	}
+	if err := os.MkdirAll("upload", 0700); err != nil {
+		return "", err
+	}
+	root, err := filepath.Abs("upload")
+	if err != nil {
+		return "", err
+	}
+	realRoot, err := filepath.EvalSymlinks(root)
+	if err != nil || realRoot != root {
+		return "", errors.New("symlinked upload root")
+	}
+	dir := filepath.Join("upload", owner)
+	if err := os.MkdirAll(dir, 0700); err != nil {
+		return "", err
+	}
+	absolute, err := filepath.Abs(dir)
+	if err != nil {
+		return "", err
+	}
+	real, err := filepath.EvalSymlinks(absolute)
+	if err != nil || real != absolute {
+		return "", errors.New("symlinked upload owner")
+	}
+	return dir, nil
+}
+
+// An empty owner permits authenticated resource reads across this manager's uploads.
+func Uploaded(owner, name string) (string, error) {
+	if name == "" || (owner != "" && !Component(owner)) {
+		return "", errors.New("invalid upload path")
+	}
+	root := "upload"
+	if owner != "" {
+		root = filepath.Join(root, owner)
+	}
+	root, err := filepath.Abs(root)
+	if err != nil {
+		return "", err
+	}
+	realRoot, err := filepath.EvalSymlinks(root)
+	if err != nil || realRoot != root {
+		return "", errors.New("symlinked upload directory")
+	}
+	absolute, err := filepath.Abs(name)
+	if err != nil {
+		return "", err
+	}
+	relative, err := filepath.Rel(root, absolute)
+	if err != nil || relative == "." || relative == ".." || strings.HasPrefix(relative, ".."+string(filepath.Separator)) {
+		return "", errors.New("path outside uploads")
+	}
+	info, err := os.Lstat(absolute)
+	if err != nil || !info.Mode().IsRegular() {
+		return "", errors.New("upload is not a regular file")
+	}
+	real, err := filepath.EvalSymlinks(absolute)
+	if err != nil || real != absolute {
+		return "", errors.New("symlinked upload file")
+	}
+	return absolute, nil
+}
