+package filesafe
+
+import (
+	"os"
+	"path/filepath"
+	"testing"
+)
+
+func TestUploadRecoveryBoundary(t *testing.T) {
+	for _, value := range []string{"", ".", "..", "../escape", "/tmp/escape", "a/b", "a\\b", "a\x00b"} {
+		if Component(value) {
+			t.Fatalf("accepted unsafe component %q", value)
+		}
+	}
+	if !Component("样例-data.csv") {
+		t.Fatal("rejected a normal filename")
+	}
+	original, err := os.Getwd()
+	if err != nil {
+		t.Fatal(err)
+	}
+	root := t.TempDir()
+	if err := os.Chdir(root); err != nil {
+		t.Fatal(err)
+	}
+	defer os.Chdir(original)
+	for _, owner := range []string{"alice", "bob"} {
+		dir, err := UploadDir(owner)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if err := os.WriteFile(filepath.Join(dir, "data.csv"), []byte("id\n1\n"), 0600); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if _, err := Uploaded("alice", "upload/alice/data.csv"); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := Uploaded("", "upload/bob/data.csv"); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile("outside.csv", []byte("private"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Symlink(filepath.Join(root, "outside.csv"), "upload/alice/link.csv"); err != nil {
+		t.Fatal(err)
+	}
+	for _, path := range []string{"outside.csv", "upload/bob/data.csv", "upload/alice/link.csv", "upload/alice", "upload/alice/../../../outside.csv"} {
+		if _, err := Uploaded("alice", path); err == nil {
+			t.Fatalf("accepted unsafe upload %q", path)
+		}
+	}
+	if err := os.Symlink(filepath.Join(root, "upload", "bob"), "upload/mallory"); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := UploadDir("mallory"); err == nil {
+		t.Fatal("accepted a symlinked owner directory")
+	}
+}
