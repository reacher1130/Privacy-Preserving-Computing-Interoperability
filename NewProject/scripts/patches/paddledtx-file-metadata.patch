+package filemeta
+
+import (
+	"reflect"
+	"testing"
+)
+
+func TestFeaturesMetadataCompatibility(t *testing.T) {
+	for _, input := range []string{
+		`[{"name":"id","type":"int","description":"identifier"},{"name":"CRIM","type":"float"},{"name":"MEDV","type":"float"}]`,
+		`{"fileType":"csv","features":"id,CRIM,MEDV","totalRows":506}`,
+		` {"features":" id, CRIM,MEDV "} `,
+	} {
+		got, err := Features([]byte(input))
+		if err != nil || !reflect.DeepEqual(got, []string{"id", "CRIM", "MEDV"}) {
+			t.Fatalf("column names/order changed: %v, %v", got, err)
+		}
+	}
+}
+
+func TestFeaturesRejectsInvalidMetadata(t *testing.T) {
+	for _, input := range []string{
+		``, `null`, `true`, `"id,x"`, `[]`, `[null]`, `[1]`, `[{}]`, `[{"name":12}]`,
+		`{}`, `{"features":null}`, `{"features":[]}`, `{"features":1}`, `{"features":""}`,
+		`{"features":"id,,x"}`, `{"features":"id, "}`, `{"features":"id,id"}`,
+		`{"features":"id, id "}`, `[{"name":"id"},{"name":"id"}]`, `[{"name":" "}]`,
+		`[{"name":"id,x"}]`, `[{"name":"id\n"}]`, `{"features":"id\u0000,x"}`, `{"features":"id,x"`,
+	} {
+		if got, err := Features([]byte(input)); err == nil {
+			t.Fatalf("invalid metadata accepted: %q -> %v", input, got)
+		}
+	}
+}
