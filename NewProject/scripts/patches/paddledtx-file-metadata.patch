+package filemeta
+
+import (
+	"bytes"
+	"encoding/json"
+	"fmt"
+	"strings"
+)
+
+// Features reads the ordered column names used by both supported file metadata formats.
+func Features(extra []byte) ([]string, error) {
+	extra = bytes.TrimSpace(extra)
+	if len(extra) == 0 {
+		return nil, fmt.Errorf("missing file metadata")
+	}
+	var features []string
+	switch extra[0] {
+	case '[':
+		var columns []struct {
+			Name string `json:"name"`
+		}
+		if err := json.Unmarshal(extra, &columns); err != nil {
+			return nil, fmt.Errorf("invalid column metadata: %w", err)
+		}
+		for _, column := range columns {
+			features = append(features, column.Name)
+		}
+	case '{':
+		var info struct {
+			Features string `json:"features"`
+		}
+		if err := json.Unmarshal(extra, &info); err != nil {
+			return nil, fmt.Errorf("invalid file metadata: %w", err)
+		}
+		features = strings.Split(info.Features, ",")
+	default:
+		return nil, fmt.Errorf("unsupported file metadata format")
+	}
+	if len(features) == 0 {
+		return nil, fmt.Errorf("missing file features")
+	}
+	seen := make(map[string]bool, len(features))
+	for i, feature := range features {
+		if strings.ContainsAny(feature, ",\x00\r\n") {
+			return nil, fmt.Errorf("invalid file feature name")
+		}
+		feature = strings.TrimSpace(feature)
+		if feature == "" {
+			return nil, fmt.Errorf("invalid file feature name")
+		}
+		if seen[feature] {
+			return nil, fmt.Errorf("duplicate file feature name")
+		}
+		seen[feature] = true
+		features[i] = feature
+	}
+	return features, nil
+}
